{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/portfolio build",
  "outputDirectory": "artifacts/portfolio/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
